---
extends: default
ignore: |
  .venv/
rules:
  line-length:
    max: 120
    level: warning
  indentation:
    spaces: 2
  trailing-spaces: enable
  document-start: disable
  truthy:
    level: warning
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
